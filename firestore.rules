rules_version = '2';

// =============================================================================
// RARAJU — Cloud Firestore Security Rules
//
// The previous version of this file granted `allow read, write: if true` on every
// collection PLUS a `/{document=**}` catch-all. That means anyone on the internet
// holding the (public, client-side) Firebase project id could read and overwrite the
// entire database — including `stores`, which stores each branch's login password in
// plain text, and `auditLogs`, which is meant to be immutable.
//
// These rules keep the app working exactly as it does today while requiring a signed-in
// user, restricting head-office configuration to admins, and making the audit trail
// append-only. The previous file is kept at firestore.rules.previous-open-backup.
//
// DEPLOY WITH:  firebase deploy --only firestore:rules
// Test in the Firebase console Rules Playground first, and sign in as BOTH an admin and
// a store cashier afterwards to confirm nothing is blocked.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Keep this list in sync with ADMIN_EMAILS in src/services/adminConfig.ts.
    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email in [
        'raraju@gmail.com',
        'admin@raraju.com'
      ];
    }

    // exists() guard: a plain get().data.role on a missing document makes the whole
    // rule error out (which denies the request) instead of evaluating to false.
    function hasAdminRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isAdminEmail() || hasAdminRole();
    }

    // -------------------------------------------------------------------------
    // Head-office configuration — readable by staff, writable by admins only.
    // -------------------------------------------------------------------------

    // 1. Users. A signed-in user may create/update their own record on first login;
    //    everything else (creating cashiers, changing roles, deactivating accounts)
    //    is admin-only.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // 2. Store branches. Contains loginPassword, so staff read but never write.
    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Product catalog.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Product categories.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Business settings & thermal invoice config.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Daily operations — cashiers write these during a shift.
    // -------------------------------------------------------------------------

    // 6. Daily stock assignments. Admin sets assignedQuantity; the POS increments
    //    soldQuantity/remainingQuantity as bills are completed.
    match /dailyStockAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin();
    }

    // 7. Store inventory.
    match /inventory/{inventoryId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 8. Stock movement ledger (IN, OUT, SALE, ADJUSTMENT, RETURN) — append-only.
    match /stockMovements/{movementId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    // 9. Stock transfers (store-to-store).
    match /stockTransfers/{transferId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 10. Stock reconciliation reports.
    match /reconciliations/{reportId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 11. Sales & invoices. Cashiers raise bills; only an admin may amend or void one.
    match /sales/{saleId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 12. Daily register closings.
    match /dailyClosings/{closingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 13. Store expenses.
    match /expenses/{expenseId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 14. Supplier purchases / inward stock.
    match /purchases/{purchaseId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 15. Customers & credit balances.
    match /customers/{customerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 16. Notifications & low-stock alerts.
    match /notifications/{notifId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 17. Atomic invoice / bill number counters.
    match /counters/{counterId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 18. Immutable audit trail — append-only, never edited or deleted.
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Default deny. There is deliberately NO `/{document=**}` allow-all catch-all:
    // any new collection must be granted access explicitly above.
    // -------------------------------------------------------------------------
  }
}
