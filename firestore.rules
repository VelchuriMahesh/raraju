rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['raraju@gmail.com', 'admin@raraju.com'] ||
        (userDocExists() && getUserData().role == 'SUPER_ADMIN')
      );
    }

    function isStoreStaff() {
      return userDocExists() && getUserData().role == 'STORE_STAFF';
    }

    function userStoreId() {
      return getUserData().storeId;
    }

    function canAccessStore(storeId) {
      return isAdmin() || (isStoreStaff() && userStoreId() == storeId);
    }

    function validStoreScopedCreate() {
      return request.resource.data.storeId is string &&
        canAccessStore(request.resource.data.storeId);
    }

    function validStoreScopedRead() {
      return resource.data.storeId is string &&
        canAccessStore(resource.data.storeId);
    }

    function validNonNegativeQuantity() {
      return request.resource.data.quantity is number &&
        request.resource.data.quantity >= 0;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAdmin() ||
        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'STORE_STAFF' &&
          request.resource.data.storeId is string
        );
      allow update: if isAdmin() ||
        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.storeId == resource.data.storeId
        );
      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /dailyStockAssignments/{assignmentId} {
      allow read: if validStoreScopedRead();
      allow create: if isAdmin() &&
        request.resource.data.storeId is string &&
        request.resource.data.productId is string &&
        request.resource.data.date is string &&
        request.resource.data.assignedQuantity is number &&
        request.resource.data.assignedQuantity >= 0 &&
        request.resource.data.remainingQuantity is number &&
        request.resource.data.remainingQuantity >= 0;
      allow update: if isAdmin() ||
        (
          isStoreStaff() &&
          resource.data.storeId == userStoreId() &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.productId == resource.data.productId &&
          request.resource.data.date == resource.data.date &&
          request.resource.data.assignedQuantity == resource.data.assignedQuantity &&
          request.resource.data.soldQuantity is number &&
          request.resource.data.soldQuantity >= resource.data.soldQuantity &&
          request.resource.data.remainingQuantity is number &&
          request.resource.data.remainingQuantity >= 0
        );
      allow delete: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if validStoreScopedRead();
      allow create: if isAdmin() &&
        request.resource.data.storeId is string &&
        request.resource.data.productId is string &&
        validNonNegativeQuantity();
      allow update: if isAdmin() ||
        (
          isStoreStaff() &&
          resource.data.storeId == userStoreId() &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.productId == resource.data.productId &&
          validNonNegativeQuantity()
        );
      allow delete: if isAdmin();
    }

    match /stockMovements/{movementId} {
      allow read: if validStoreScopedRead();
      allow create: if validStoreScopedCreate();
      allow update, delete: if isAdmin();
    }

    match /stockTransfers/{transferId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if validStoreScopedRead();
      allow create: if validStoreScopedCreate();
      allow update, delete: if isAdmin();
    }

    match /dailyClosings/{closingId} {
      allow read: if validStoreScopedRead();
      allow create: if validStoreScopedCreate();
      allow update: if isAdmin() ||
        (
          isStoreStaff() &&
          resource.data.storeId == userStoreId() &&
          request.resource.data.storeId == resource.data.storeId
        );
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin() || validStoreScopedRead();
      allow create: if isAdmin() || validStoreScopedCreate();
      allow update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() ||
        (
          isStoreStaff() &&
          (
            !('storeId' in resource.data) ||
            resource.data.storeId == userStoreId()
          )
        );
      allow create: if isAuthenticated();
      allow update: if isAdmin() ||
        (
          isStoreStaff() &&
          (
            !('storeId' in resource.data) ||
            resource.data.storeId == userStoreId()
          )
        );
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update: if isAdmin() ||
        (
          isStoreStaff() &&
          counterId == 'invoice_' + userStoreId()
        );
      allow delete: if isAdmin();
    }

    match /reconciliations/{reconciliationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
